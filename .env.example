# Create a bot with @BotFather. Keep this token private.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID, not username. Only this user in a private chat is allowed.
TELEGRAM_OWNER_ID=
TRADING_MODE=paper
# Jupiter API key; optional at the lower public rate limit.
JUPITER_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional existing Solana CLI keypair. Otherwise create an encrypted wallet in the Mini App.
WALLET_KEYPAIR_PATH=
# Enter your wallet encryption key in the authenticated Mini App, not here.
# Live mode also requires this exact acknowledgement.
LIVE_TRADING_ACK=
# LIVE_TRADING_ACK=I_UNDERSTAND_REAL_FUNDS
SLIPPAGE_BPS=50
MAX_TRADE_USDC=1
MAX_DAILY_USDC=5
MIN_SOL_RESERVE=0.02
MAX_NETWORK_FEE_SOL=0.01
QUOTE_TTL_SECONDS=20
PAPER_USDC=1
PAPER_SOL=1
DATA_DIR=./data
TRADE_SIZE_USDC=0.25
SAMPLE_SECONDS=60
EMA_FAST=5
EMA_SLOW=12
STOP_LOSS_BPS=300
TAKE_PROFIT_BPS=600
# Public HTTPS origin required to launch inside Telegram.
PUBLIC_APP_URL=
HOST=127.0.0.1
PORT=3000
